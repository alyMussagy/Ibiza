{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["../../src/*"],
      "@admin/*": ["./src/*"]
    },
    "incremental": true,
    "tsBuildInfoFile": "./.next/tsconfig.tsbuildinfo"
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "../../node_modules", "../../src/**/*.test.ts", "../../src/**/*.test.tsx"]
}
