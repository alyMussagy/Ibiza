# Public Supabase values. Copy to .env.local; never commit actual credentials.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase PostgreSQL connection, transaction pooler recommended.
DATABASE_URL=
# No payment provider credentials are required in Phase 1.
